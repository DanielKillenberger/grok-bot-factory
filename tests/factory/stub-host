#!/usr/bin/env bash
# Test-only host CLI. Records argv. Never a live model or Cloud Agent.
set -euo pipefail

if [ -n "${FACTORY_HOST_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$FACTORY_HOST_LOG"
fi
if [ -n "${FACTORY_HOST_PWD_LOG:-}" ]; then
  printf '%s\n' "$PWD" >>"$FACTORY_HOST_PWD_LOG"
fi

if [ "${1:-}" = "--help" ]; then
  case "${FACTORY_HOST_HELP:-loop}" in
    none)
      printf '%s\n' "usage: grok"
      ;;
    goal)
      printf '%s\n' "/goal"
      ;;
    *)
      printf '%s\n' "/loop"
      printf '%s\n' "/goal"
      ;;
  esac
  exit 0
fi

if [ -n "${FACTORY_HOST_SLEEP:-}" ]; then
  sleep "$FACTORY_HOST_SLEEP"
fi
if [ -n "${FACTORY_HOST_HOLD:-}" ]; then
  mkdir -p -- "$FACTORY_HOST_HOLD"
  printf '%s\n' "$PWD" >"$FACTORY_HOST_HOLD/pwd.$$"
  while [ ! -f "$FACTORY_HOST_HOLD/release" ]; do
    sleep 0.05
  done
fi

case "${FACTORY_HOST_MUTATE:-}" in
  delete-pin)
    rm -f -- .flow/config.json
    ;;
  unrelated)
    if [ -f .flow/config.json ]; then
      jq '.land.patienceMinutes=99' .flow/config.json >.flow/config.json.tmp
      mv .flow/config.json.tmp .flow/config.json
    fi
    ;;
esac

verdict="${FACTORY_HOST_VERDICT:-NO_WORK}"
if [[ " $* " == *" /flow-next:land "* ]]; then
  printf 'LAND_VERDICT=%s prs=0 reason="fixture"\n' "$verdict"
else
  printf 'PILOT_VERDICT=%s spec=fn-x stage=work reason="fixture"\n' "$verdict"
fi
if [ "${FACTORY_HOST_EXIT:-0}" -ne 0 ]; then
  printf 'also mentions NO_WORK in stderr\n' >&2
  exit "$FACTORY_HOST_EXIT"
fi
exit 0
